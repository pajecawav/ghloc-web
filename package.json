{
	"name": "ghloc-web",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "cross-env FORCE_COLOR=1 run-s -l build:languages build:sitemap build:vite",
		"build:languages": "tsx scripts/build-languages.ts",
		"build:sitemap": "tsx scripts/build-sitemap.ts",
		"build:vite": "vite build",
		"dev": "cross-env FORCE_COLOR=1 npm-run-all -l -s build:languages dev:vite",
		"dev:vite": "vite",
		"preview": "node .output/server/index.mjs",
		"lint": "cross-env FORCE_COLOR=1 run-p -lc lint:*",
		"lint:oxlint": "oxlint .",
		"lint:tsc": "tsgo --noEmit",
		"lint:format": "pt format --check",
		"format": "pt format",
		"clean": "rimraf .output .vercel node_modules/.cache",
		"prepare": "pt prepare"
	},
	"dependencies": {
